# ==============================================================================
# HEPCO IT COMMAND CENTER (HICC V1.0) - ENVIRONMENT CONFIGURATION TEMPLATE
# Environment: Internal LAN / On-Premise Server
# ==============================================================================

# --- 1. Application & Environment ---
APP_NAME="HEPCO IT COMMAND CENTER"
APP_VERSION="1.0.0"
APP_ENV="production"
TIMEZONE="Asia/Ho_Chi_Minh"
LOG_LEVEL="INFO"

# --- 2. PostgreSQL 16 Database Configuration ---
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_DB="hicc_db"
POSTGRES_USER="hicc_user"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"
DATABASE_URL="postgresql+psycopg://hicc_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/hicc_db"

# --- 3. Security & Cryptography Keys ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="CHANGE_ME_64_HEX_CHARACTERS_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting SNMPv3/v2c & ONVIF credentials at rest
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HICC_CREDENTIAL_MASTER_KEY="CHANGE_ME_32_BYTE_URLSAFE_BASE64_FERNET_KEY="

# --- 4. Scanner Engine Runtime Configuration ---
# Network interface attached to HEPCO LAN (e.g. eth0, ens18)
SCANNER_NETWORK_INTERFACE="eth0"
SCANNER_MAX_CONCURRENCY_ICMP=64
SCANNER_MAX_CONCURRENCY_TCP=32
SCANNER_ICMP_COUNT=3
SCANNER_ICMP_TIMEOUT_MS=1000
SCANNER_TCP_TIMEOUT_MS=1200

# Default schedules (can be overridden dynamically in system_settings table)
SCANNER_STATUS_CHECK_INTERVAL_SEC=60
SCANNER_DISCOVERY_INTERVAL_SEC=300
SCANNER_SNMP_POLL_INTERVAL_SEC=300
SCANNER_FULL_SCAN_INTERVAL_SEC=900
SCANNER_HOSTNAME_REFRESH_INTERVAL_SEC=1800

# Internal DNS server for Reverse DNS lookups (leave blank to use system resolver)
INTERNAL_DNS_SERVER=""
