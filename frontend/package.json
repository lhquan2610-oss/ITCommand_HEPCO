{
  "name": "hepco-it-command-center",
  "productName": "HEPCO COMMAND",
  "description": "Trung Tâm Quản Trị Hạ Tầng Mạng, Máy Chủ & Tài Sản CNTT HEPCO",
  "private": true,
  "version": "1.1.0",
  "author": "Lê Hồng Quân - Bộ Phận CNTT HEPCO",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron": "electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder --win --x64",
    "dist:portable": "vite build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "vn.com.hepco.command",
    "productName": "HEPCO COMMAND",
    "copyright": "Bản quyền © 2026 Công ty Cổ phần Môi trường và Công trình Đô thị Huế (HEPCO)",
    "directories": {
      "output": "../dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/dahua-sdk/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../data/devices_inventory.json",
        "to": "data/devices_inventory.json"
      },
      {
        "from": "electron/dahua-sdk",
        "to": "dahua-sdk"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HEPCO COMMAND",
      "uninstallDisplayName": "Gỡ cài đặt HEPCO COMMAND",
      "artifactName": "HEPCO_COMMAND_Cai_Dat.exe"
    },
    "portable": {
      "artifactName": "HEPCO_COMMAND_PORTABLE.exe"
    },
    "compression": "maximum"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.11"
  }
}
